{
  "name": "js-build-tools",
  "version": "8.4.1",
  "description": "Standardised build process with gulp.",
  "main": "gulpfile.base.js",
  "exports": {
    ".": {
      "node": "./gulpfile.base.js",
      "default": "./gulpfile.base.mjs"
    },
    "./babel.config": "./babel.config.js",
    "./gulp.config": "./gulp.config.js",
    "./gulp.config.mjs": "./gulp.config.mjs",
    "./gulpfile.base": "./gulpfile.base.js",
    "./gulpfile.base.mjs": "./gulpfile.base.mjs",
    "./jsdoc.base": "./jsdoc.base.js",
    "./testHelpers": "./dist/testHelpers.js",
    "./testHelpers.mjs": "./functions/testHelpers.mjs"
  },
  "scripts": {
    "build": "node --experimental-vm-modules node_modules/gulp/bin/gulp.js build",
    "dev": "gulp",
    "docs": "gulp docs",
    "lint": "gulp lint",
    "prepublishOnly": "npm run build",
    "readme": "gulp readme",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "test": "node --experimental-vm-modules node_modules/gulp/bin/gulp.js testFull",
    "test:quick": "node --experimental-vm-modules node_modules/gulp/bin/gulp.js testQuick",
    "watch": "node --experimental-vm-modules node_modules/gulp/bin/gulp.js watchFull",
    "watch:test": "node --experimental-vm-modules node_modules/gulp/bin/gulp.js watchTest"
  },
  "repository": "github:jheagle/js-build-tools",
  "keywords": [
    "gulp",
    "build",
    "node",
    "bundler"
  ],
  "author": "Joshua Heagle <joshuaheagle@gmail.com> (https://joshuaheagle.com)",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/jheagle/js-build-tools/issues"
  },
  "homepage": "https://github.com/jheagle/js-build-tools#readme",
  "standard": {
    "env": [
      "jest"
    ]
  },
  "dependencies": {
    "@babel/core": "^8.1.0",
    "@babel/plugin-transform-dynamic-import": "^8.0.1",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@babel/runtime-corejs3": "^8.1.0",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "core-js": "^3.51.0",
    "cssnano": "^9.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "glob": "^14.0.3",
    "gulp": "^5.0.1",
    "gulp-babel": "^8.1.0",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-sass": "^6.0.1",
    "gulp-ts-compile": "^1.0.2",
    "gulp-uglify-es": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdoc-to-markdown": "^9.1.3",
    "neostandard": "^0.14.1",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.32",
    "process": "^0.11.10",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.107.1",
    "test-filesystem": "^2.1.0",
    "through2": "^5.0.12",
    "vinyl": "^3.0.1"
  },
  "peerDependencies": {
    "clean-jsdoc-theme": ">=4.0.0",
    "gulp-imagemin": ">=9.0.0",
    "jsdoc": ">=4.0.0",
    "playwright": ">=1.40.0",
    "typedoc": ">=0.28.0",
    "typescript": ">=5.0.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "clean-jsdoc-theme": {
      "optional": true
    },
    "gulp-imagemin": {
      "optional": true
    },
    "jsdoc": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "typedoc": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "babel.config.js",
    "dist",
    "functions",
    "gulpfile.base.js",
    "gulpfile.base.mjs",
    "gulp.config.js",
    "gulp.config.mjs",
    "jsdoc.base.js",
    "jsdoc.esmExports.js"
  ],
  "funding": "https://www.paypal.com/donate/?business=LRYR6SZRWKXVY&no_recurring=0&item_name=Let%27s+build+together+today+to+simplify+our+jobs+tomorrow.&currency_code=CAD",
  "devDependencies": {
    "clean-jsdoc-theme": "^5.2.1",
    "gulp-imagemin": "github:jheagle/gulp-imagemin#common-js-compatibility",
    "jsdoc": "^4.0.5",
    "playwright": "^1.64.1",
    "release-it": "^21.1.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0"
  },
  "allowScripts": {
    "gifsicle@5.3.0": true,
    "mozjpeg@8.0.0": true,
    "optipng-bin@7.0.1": true,
    "core-js": false,
    "core-js-pure": false,
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "esbuild": false
  }
}
