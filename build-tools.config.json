{
  "browser": {
    "name": "js-build-tools",
    "from": "dist/*.js",
    "to": "browser",
    "enabled": false
  },
  "cleanPaths": [
    "dist",
    "browser"
  ],
  "dist": {
    "main": "gulpfile.base.js",
    "from": "functions/**/!(*.test).mjs",
    "to": "dist"
  },
  "docs": {
    "enabled": true,
    "from": [
      "functions",
      "gulpfile.base.mjs",
      "gulp.config.mjs"
    ],
    "index": "MAIN.md",
    "title": "JS Build Tools",
    "to": "../joshuaheagle.local/projects/js-build-tools/docs",
    "inBuild": false
  },
  "readme": {
    "template": "MAIN.md",
    "options": "utf8",
    "from": [
      "gulpfile.base.js",
      "dist/!(*.test).js",
      "dist/partials/!(*.test).js",
      "dist/test-helpers/!(*.test).js"
    ],
    "fromEsm": [
      "gulp.config.mjs"
    ],
    "to": "./"
  },
  "rootPath": "./",
  "sass": {
    "outPath": "browser/css",
    "sassPath": "sass",
    "sassSearch": "sass/**/*.+(scss|sass)",
    "enabled": false
  },
  "srcPath": "functions",
  "test": {
    "options": {
      "clearCache": false,
      "debug": false,
      "experimentalVmModules": true,
      "ignoreProjects": false,
      "json": false,
      "selectProjects": false,
      "showConfig": false,
      "useStderr": false,
      "watch": false,
      "watchAll": false,
      "testMatch": [
        "**/?(*.)+(spec|test).mjs?(x)"
      ]
    },
    "path": "functions",
    "watch": "functions/**/*.[cm]?[jt]s"
  },
  "typescript": {
    "config": false,
    "from": "functions/**/*.ts",
    "to": "dist",
    "enabled": false
  }
}
